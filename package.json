{
	"name": "tradingview-re",
	"version": "3.4.1",
	"private": true,
	"description": "Runnable, readable reconstruction of the TradingView desktop app (macOS) with a DevTool panel",
	"type": "module",
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "bun scripts/build.ts",
		"start": "bun scripts/start.mjs",
		"package": "bun scripts/package-app.mjs",
		"package:standalone": "bun scripts/package-app.mjs --copy",
		"apply": "bun build/patches/apply.mjs",
		"apply:check": "bun build/patches/apply.mjs --check",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome check --write .",
		"extract": "bun scripts/extract.mjs",
		"check:devtool": "node scripts/cdp-check.mjs",
		"check:mock": "node scripts/cdp-mock-check.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "26.6.5",
		"electron": "41.7.1",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	},
	"packageManager": "bun@1.4.2"
}
